# GEMINI_API_KEY: Clave de Google Gemini API (solo servidor).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Clave pública restringida para Google Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Credenciales del proyecto Supabase.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# APP_URL: URL pública donde corre la aplicación (AI Studio / Render).
APP_URL="MY_APP_URL"
PORT="3000"
